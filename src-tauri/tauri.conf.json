{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AInside",
  "version": "0.1.0",
  "identifier": "com.ainside.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AInside",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "AInside",
    "copyright": "Copyright © 2026 AndreaZero",
    "category": "Productivity",
    "shortDescription": "Modelli AI in locale, senza configurazione",
    "longDescription": "AInside esegue modelli AI sul tuo computer. Analizza l'hardware, sceglie la versione del modello e configura il runtime. Interfaccia in italiano. Nessun account: chat e file restano sul disco.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Italian"]
      }
    }
  }
}
